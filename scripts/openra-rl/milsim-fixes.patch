+    """Pick a model, offering what the provider actually has installed.
+
+    For local providers we ask the daemon which models exist rather than making
+    the user recall a tag from memory. If the daemon is not reachable we say so
+    (that is the far more likely reason a later run fails) and fall back to a
+    free-text prompt so the wizard still completes offline.
+    """
+    base_url = provider["base_url"]
+
+    installed: Optional[list[str]] = None
+    if provider_key == "ollama":
+        installed = discover_ollama_models(base_url)
+        if installed is None:
+            print()
+            warn(f"Could not reach Ollama at {_origin(base_url)} — is it running?")
+            dim("  Start it with `ollama serve`, then pull a tool-capable model:")
+            dim(f"    ollama pull {provider.get('default_model', 'qwen3:32b')}")
+        elif not installed:
+            print()
+            warn("Ollama is running but has no models pulled.")
+            dim(f"  Pull one with: ollama pull {provider.get('default_model', 'qwen3:32b')}")
+    elif provider_key == "lmstudio":
+        installed = discover_openai_models(base_url)
+        if installed is None:
+            print()
+            warn(f"Could not reach LM Studio at {_origin(base_url)} — is the server started?")
+            dim("  In LM Studio: Developer tab -> Start Server, then load a model.")
+        elif not installed:
+            print()
+            warn("LM Studio is running but has no model loaded.")
+
+    if installed:
+        return _choose(
+            "Choose a model:",
+            [(m, m) for m in installed],
+            allow_custom=True,
+        )
+
+    if provider.get("models"):
+        return _choose(
+            "Choose a model:",
+            [(m, label) for m, label in provider["models"]],
+            allow_custom=True,
+        )
+
+    return _prompt("Enter model ID", default=provider.get("default_model", ""))
+
+
