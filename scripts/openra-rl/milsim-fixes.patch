@@ -35,6 +39,137 @@ PROVIDERS = {
 }
 
 
+# Hostnames that resolve to the machine the CLI is running on (or, from inside
+# a container, to its host). An endpoint on one of these never needs an API key.
+LOCAL_HOSTS = (
+    "localhost",
+    "127.0.0.1",
+    "0.0.0.0",
+    "::1",
+    "host.docker.internal",
+)
+
+
+def is_local_endpoint(base_url: str) -> bool:
+    """True if ``base_url`` points at a loopback/host-local address.
+
+    Matches on the parsed hostname rather than a raw substring so that a
+    remote host merely *containing* one of the names (e.g.
+    ``https://localhost.example.com``) is not mistaken for a local one.
+    Falls back to substring matching when the URL cannot be parsed.
+    """
+    if not base_url:
+        return False
+    try:
+        host = urllib.parse.urlsplit(base_url).hostname or ""
+    except ValueError:
+        host = ""
+    if host:
+        return host.lower().strip("[]") in LOCAL_HOSTS
+    lowered = base_url.lower()
+    return any(h in lowered for h in LOCAL_HOSTS)
+
+
+def requires_api_key(config: dict) -> bool:
+    """True if this config needs an API key before the agent can run.
+
+    Provider first: ``PROVIDERS[provider]["needs_key"]`` is authoritative, so a
+    remote Ollama host (``http://ollama:11434/...``, a LAN IP, ...) is correctly
+    treated as keyless. Only when the provider is unknown do we fall back to
+    inspecting the URL.
+    """
+    llm_cfg = config.get("llm", {}) or {}
+    if llm_cfg.get("api_key"):
+        return False
+    provider = PROVIDERS.get(config.get("provider", ""))
+    if provider is not None:
+        return bool(provider.get("needs_key"))
+    return not is_local_endpoint(llm_cfg.get("base_url", ""))
+
+
+def _origin(base_url: str) -> str:
+    """Return the scheme://host:port prefix of a full endpoint URL."""
+    parts = urllib.parse.urlsplit(base_url)
+    if not parts.scheme or not parts.netloc:
+        return ""
+    return f"{parts.scheme}://{parts.netloc}"
+
+
+def _http_get_json(url: str, timeout: float = 2.0) -> Optional[dict]:
+    """GET a JSON document. Returns None on any transport or decode failure."""
+    try:
+        req = urllib.request.Request(url, headers={"Accept": "application/json"})
+        with urllib.request.urlopen(req, timeout=timeout) as resp:
+            if resp.status != 200:
+                return None
+            return json.loads(resp.read().decode("utf-8"))
+    except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
+        return None
+
+
+def discover_ollama_models(base_url: str, timeout: float = 2.0) -> Optional[list[str]]:
+    """List models pulled on the Ollama daemon behind ``base_url``.
+
+    Uses Ollama's native ``GET /api/tags``. Returns a (possibly empty) list of
+    model tags when the daemon answers, or None when it is unreachable — the
+    caller needs to tell those two cases apart.
+    """
+    origin = _origin(base_url)
+    if not origin:
+        return None
+    data = _http_get_json(f"{origin}/api/tags", timeout=timeout)
+    if not isinstance(data, dict):
+        return None
+    models = data.get("models")
+    if not isinstance(models, list):
+        return None
+    names = [m.get("name") for m in models if isinstance(m, dict) and m.get("name")]
+    return sorted(str(n) for n in names)
+
+
+def discover_openai_models(base_url: str, timeout: float = 2.0) -> Optional[list[str]]:
+    """List models from an OpenAI-compatible ``GET /v1/models`` endpoint.
+
+    ``base_url`` is the full chat-completions URL; the models URL is derived by
+    swapping the trailing ``/chat/completions`` for ``/models``. Returns None
+    when the server is unreachable or answers with something unexpected.
+    """
+    suffix = "/chat/completions"
+    root = base_url[: -len(suffix)] if base_url.endswith(suffix) else base_url.rstrip("/")
+    if not root:
+        return None
+    data = _http_get_json(f"{root}/models", timeout=timeout)
+    if not isinstance(data, dict):
+        return None
+    entries = data.get("data")
+    if not isinstance(entries, list):
+        return None
+    names = [e.get("id") for e in entries if isinstance(e, dict) and e.get("id")]
+    return sorted(str(n) for n in names)
+
+
+def probe_llm_endpoint(base_url: str, timeout: float = 2.0) -> tuple[bool, str]:
+    """Check that *something* is listening on the LLM endpoint.
+
+    Returns ``(reachable, detail)``. An HTTP error status still counts as
+    reachable — a 401/404 proves a server answered, which is all this check
+    is trying to establish.
+    """
+    origin = _origin(base_url)
+    if not origin:
+        return False, f"unparseable base_url: {base_url!r}"
+    try:
+        req = urllib.request.Request(origin, method="GET")
+        with urllib.request.urlopen(req, timeout=timeout) as resp:
+            return True, f"HTTP {resp.status}"
+    except urllib.error.HTTPError as exc:
+        return True, f"HTTP {exc.code}"
+    except urllib.error.URLError as exc:
+        return False, str(exc.reason)
+    except OSError as exc:
+        return False, str(exc)
+
+
 def _prompt(question: str, default: str = "") -> str:
     """Prompt user for input with optional default."""
     if default:
