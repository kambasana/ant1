+# OpenRA-RL config for Ollama running on ANOTHER host (LAN box, Docker, ...)
+# Usage: python examples/llm_agent.py --config examples/config-ollama-remote.yaml --no-api-key
+#
+# NOTE: llm.base_url is the FULL chat-completions endpoint, path included.
+# openra-rl POSTs to it verbatim — it does not append "/chat/completions".
+#
+# Ollama needs no API key wherever it runs. Because this host is not loopback,
+# the CLI's "is this local?" check cannot infer that on its own:
+#   - examples/llm_agent.py  -> pass --no-api-key
+#   - openra-rl play         -> keep `provider: ollama` below; the provider
+#                               preset's needs_key=False is what is consulted.
+provider: ollama
+
+llm:
+  # Replace with your Ollama host: a LAN IP, a Docker service name
+  # (http://ollama:11434/...), or http://host.docker.internal:11434/...
+  base_url: "http://ollama.lan:11434/v1/chat/completions"
+  model: "qwen3:32b"
+  api_key: ""                         # No key needed for Ollama, local or remote
+  max_tokens: 2000
+  extra_headers: {}
+  request_timeout_s: 300.0            # Local models need more time
+
+agent:
+  max_time_s: 3600
+  verbose: true
