@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""Smoke check: create 1 session, advance ticks, destroy.
+
+Manual script: requires an OpenRA multi-session gRPC daemon already listening on
+localhost:9999 (see stress_multi_session.py, which spawns one itself). Not a
+pytest test — it talks to a live server and is run by hand:
+
+    python scripts/manual/smoke_single_session.py
+"""
+import os
+import sys
+import time
+
+import grpc
+
+# Repo root is two levels up from scripts/manual/
+_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+sys.path.insert(0, _REPO_ROOT)
+
+from openra_env.generated import rl_bridge_pb2, rl_bridge_pb2_grpc
+
+GRPC_PORT = int(os.environ.get("RL_GRPC_PORT", "9999"))
+
+
+def main() -> int:
+    ch = grpc.insecure_channel(
+        f"localhost:{GRPC_PORT}", options=[("grpc.max_receive_message_length", 64 * 1024 * 1024)]
+    )
+    stub = rl_bridge_pb2_grpc.RLBridgeStub(ch)
+
+    print("Creating session...")
+    resp = stub.CreateSession(
+        rl_bridge_pb2.CreateSessionRequest(
+            map_name="singles.oramap", bots="Multi1:rl-agent,Multi0:beginner", seed=42
+        ),
+        timeout=10,
+    )
+    sid = resp.session_id
